{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js android",
    "lint": "tsc --noEmit",
    "sync:ai": "node scripts/sync-ai.mjs --from ../AI-engine",
    "server:build": "tsc -p tsconfig.server.json && node scripts/write-cjs-flag.mjs",
    "server:match": "npm run server:build && node dist-server/server/host/node-host.js",
    "test:server": "npm run server:build && node --test dist-server/server/__tests__/",
    "smoke:worker": "node scripts/smoke-worker.mjs",
    "apk:init": "cap add android",
    "apk:sync": "npm run build && cap sync android",
    "apk:open": "cap open android",
    "apk:build": "npm run apk:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.187.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/cli": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "7.1.0-beta"
  }
}
